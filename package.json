{
  "name": "outlast-trials-companion",
  "version": "1.1.0",
  "private": true,
  "description": "Outlast Trials Companion — справочник, таймер с чеклистом и интерактивные карты испытаний",
  "author": {
    "name": "G1drohz",
    "email": "186801004+G1drohz@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "build:win": "npm run icons && electron-builder --win nsis portable --x64 --publish never",
    "build:linux": "npm run icons && electron-builder --linux AppImage deb --x64 --publish never",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "build:apk": "cd android && ./gradlew assembleDebug --no-daemon",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "dev.g1drohz.outlasttrials",
    "productName": "Outlast Trials Companion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "web/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "OutlastTrialsCompanion-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Outlast Trials Companion",
      "artifactName": "OutlastTrialsCompanion-Setup-${version}.${ext}",
      "uninstallDisplayName": "Outlast Trials Companion"
    },
    "portable": {
      "artifactName": "OutlastTrialsCompanion-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "OutlastTrialsCompanion-${version}-${arch}.${ext}"
    },
    "deb": {
      "synopsis": "Неофициальный компаньон для The Outlast Trials",
      "description": "Справочник, таймер с чеклистом и интерактивные карты испытаний The Outlast Trials."
    }
  }
}
